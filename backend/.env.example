# Xelora backend configuration. Copy to backend/.env and fill in real values.
# Never commit backend/.env. Every variable below is read by the code; values
# shown are the code defaults unless marked REQUIRED.

# ── Security (REQUIRED) ──────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Shared server-to-server key. The Next.js server sends it as X-API-Key;
# it must equal frontend BACKEND_API_KEY. Never expose it to browsers.
LOCAL_API_KEY=
# Development only: allow requests without LOCAL_API_KEY.
ALLOW_NO_AUTH=false
# Comma-separated browser origins allowed by CORS (e.g. http://localhost:3000).
ALLOWED_ORIGINS=http://localhost:3000
JWT_EXPIRE_MINUTES=10080
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Database / storage ──────────────────────────────────────────────
# Postgres URL. Without it the backend runs but persists nothing
# (no history, files, workflows, automations, or accounts).
DATABASE_URL=
# Private per-user upload storage (STORAGE_DIR/<user_id>). The agent file
# tools use exactly the same root. Default: backend/storage. Uncomment the
# path overrides below only with real values.
# STORAGE_DIR=
MAX_UPLOAD_MB=100
# Where uploaded file contents are kept durably (local disk is then a cache):
#   local    - disk only (single PC, or a host with a persistent disk)
#   database - inside Postgres (DATABASE_URL); survives Render restarts, no extra service
#   s3       - any S3-compatible bucket (AWS S3, Cloudflare R2, ...); best for many/large files
FILE_STORAGE=local
# S3_BUCKET=
# S3_ENDPOINT_URL=          # R2: https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=xelora/
# Learned memory (task history, chat memory, skills) is stored in Postgres when
# DATABASE_URL is set, otherwise as JSON files here.
# MEMORY_STORE_DIR=
# KNOWLEDGE_INGEST_ALLOWED_DIR=

# ── AI providers (at least the key for AI_PROVIDER is REQUIRED) ─────
AI_PROVIDER=gemini
AI_PROVIDER_FALLBACK_CHAIN=openrouter,claude,gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides (comma-separated model ids, tried in order). Excel tasks
# plan better on a stronger model: put a Pro model first if your key allows it.
# GEMINI_MODEL_CHAIN=
# OPENROUTER_MODEL_CHAIN=
# Run Excel tasks on another configured provider than quick chat
# (gemini | claude | openrouter); empty = AI_PROVIDER.
# EXCEL_TASK_PROVIDER=
# CLAUDE_TASK_MODEL=claude-sonnet-4-6
GEMINI_TIMEOUT_SECONDS=20
GEMINI_TOTAL_TIMEOUT_SECONDS=45
GEMINI_RATE_LIMIT_WAIT_SECONDS=0
CLAUDE_TIMEOUT_SECONDS=35
OPENROUTER_TIMEOUT_SECONDS=35
OPENROUTER_TOTAL_TIMEOUT_SECONDS=45
OPENROUTER_INTER_MODEL_DELAY_SECONDS=0

# ── Agent loop limits ───────────────────────────────────────────────
MAX_STEPS_PER_TASK=180
MAX_RETRIES_PER_ACTION=2
SKILL_TIMEOUT_SECONDS=60
INITIAL_EXCEL_CHECK_TIMEOUT_SECONDS=8
MAX_VISUAL_ACTIONS_PER_TASK=240

# ── Excel execution layers ─────────────────────────────────────────
ENABLE_CODEGEN_LAYER=true
HYBRID_VISIBLE_MODE=true
MAXIMIZE_EXCEL_WINDOW=true
ENABLE_VISUAL_CHECKPOINTS=true
ENABLE_VISIBLE_RANGE_NAVIGATION=true
# Excel keyboard shortcuts, Ribbon KeyTips and Name Box navigation (no mouse,
# no screenshots). On by default; the full visual fallback below adds clicking.
ENABLE_EXCEL_SHORTCUTS=true
# Windows UI Automation / keyboard / mouse fallback for dialogs and ribbon.
ENABLE_VISUAL_FALLBACK=false
VISUAL_ONLY_MODE=false
OMNIPARSER_ONLY_MODE=false
ALLOW_VISUAL_STRUCTURED_EDITS=false

# ── OmniParser (fallback for unlabelled visual elements) ───────────
# Either an external service URL, or local in-process models.
OMNIPARSER_URL=
OMNIPARSER_TIMEOUT_SECONDS=120
# OMNIPARSER_LOCAL_MODE=true needs: pip install -r requirements-omniparser.txt
OMNIPARSER_LOCAL_MODE=false
ENABLE_FLORENCE_CAPTION=true

# ── Cua Driver (accessibility-first desktop control, same host as Excel)
ENABLE_CUA_DRIVER=false
# Empty = resolve `cua-driver` on PATH. Otherwise an absolute path.
CUA_DRIVER_COMMAND=
CUA_DRIVER_ARGS=mcp
# Widen the default targeting boundary (both off = safest):
CUA_ALLOW_DESKTOP_SCOPE=false
CUA_ALLOW_OTHER_APPS=false

# ── General agent tools ────────────────────────────────────────────
# Terminal: argv allowlist, no shell. Requires an existing directory root.
ENABLE_TERMINAL_TOOLS=false
XELORA_TERMINAL_ROOT=
TERMINAL_WRITE_TOOLS=false
TERMINAL_TIMEOUT_SECONDS=30
# Outbound MCP: JSON file listing servers and their allowlisted tools
# (see mcp_servers.example.json).
ENABLE_MCP_CLIENT=false
MCP_SERVERS_FILE=

# ── Features ───────────────────────────────────────────────────────
ENABLE_TASK_PLANNER=true
ENABLE_SKILL_EXTRACTION=true
ENABLE_DATA_PROFILING=true
ENABLE_PDF_REPORTS=true
ENABLE_SSE_STREAMING=true
ENABLE_MEMORY_STORAGE=true
# Memory list sizes (oldest dropped) and how many related past tasks the agent sees.
# MEMORY_MAX_CHAT_RECORDS=200
# MEMORY_MAX_TASK_RECORDS=300
# MEMORY_MAX_SKILLS=200
# MEMORY_CONTEXT_ITEMS=3

# ── Web search ─────────────────────────────────────────────────────
# Xelora searches the web when a question needs current or unfamiliar facts.
# Set ONE key for reliable results (tried in this order); without any key it
# falls back to DuckDuckGo, which often blocks cloud servers such as Render.
#   Tavily  https://tavily.com     (free tier, built for AI agents - recommended)
#   Brave   https://brave.com/search/api/
#   Serper  https://serper.dev     (Google results)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# SEARCH_PROVIDER=          # pin one: tavily | brave | serper | duckduckgo
QUICK_CHAT_WEB_SEARCH=true
# QUICK_CHAT_MAX_TOOL_ROUNDS=3
# FAST_CHAT_TIMEOUT_SECONDS=25
# FAST_CHAT_MAX_OUTPUT_TOKENS=1200
# Specialist wrappers exist as a library but are not called by the task loop.
ENABLE_SUBAGENTS=true
# Scheduled workflow runs (needs DATABASE_URL).
ENABLE_AUTOMATIONS=false
# URL the backend uses to call its own /task endpoint for workflows/automations.
INTERNAL_BASE_URL=http://localhost:8000

# ── File parsing limits (uncomment to override code defaults) ──────
# MAX_FILE_PARSE_ROWS=
# MAX_FILE_PARSE_COLUMNS=
# MAX_FILE_PREVIEW_ROWS=
# MAX_FILE_PREVIEW_CELL_CHARS=
# MAX_ARCHIVE_UNCOMPRESSED_MB=

# ── Billing / OAuth (optional) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price ids per plan (plan_catalog.py):
STRIPE_PRICE_ENV_VARS=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
SKIP_BILLING_CHECKS=false
TRIAL_DAYS=14
# Public web app URL: used for links in emails and Stripe redirects.
FRONTEND_URL=http://localhost:3000
# "Continue with Google" (console.cloud.google.com > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=

# ── Email (password reset, email confirmation) ──────────────────────
# Set ONE provider. Without one, emails are only printed to the server log.
# Brevo: https://app.brevo.com -> SMTP & API -> API Keys. EMAIL_FROM must be a
# sender or domain verified in Brevo (Senders, Domains & Dedicated IPs).
BREVO_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
EMAIL_FROM=Xelora <no-reply@yourdomain.com>

# ── Hosted deployment: desktop local agent (docs/LOCAL_AGENT.md) ──────
# server = run tasks in this process (backend on the same PC as Excel).
# agent  = queue signed-in users' tasks for their Xelora Desktop agent.
TASK_EXECUTION=server
# Public URL of this API, handed to paired desktops (e.g. https://xelora-api.onrender.com).
PUBLIC_API_URL=
