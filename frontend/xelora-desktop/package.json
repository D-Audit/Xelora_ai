{
  "name": "xelora-desktop",
  "version": "1.3.0",
  "description": "Xelora Desktop â€” AI-powered spreadsheet automation",
  "main": "main.js",
  "author": "Xelora",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "app.xelora.desktop",
    "productName": "Xelora",
    "copyright": "Copyright Â© 2026 Xelora",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xelora"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ]
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}


