# Next.js server-side settings (never exposed to the browser).
# URL of the FastAPI backend running on the same machine as Excel.
BACKEND_URL=http://localhost:8000
# Must equal backend/.env LOCAL_API_KEY.
BACKEND_API_KEY=

# Public URL of this web app (exact, no trailing slash). Google/Microsoft
# sign-in redirects back to <XELORA_APP_URL>/api/auth/<provider>/callback,
# which must be registered in the provider's console.
XELORA_APP_URL=http://localhost:3000
# Optional: secret that seals desktop sign-in handoffs. Defaults to BACKEND_API_KEY.
# XELORA_HANDOFF_SECRET=

# Sign-in buttons (Google is on by default; Microsoft needs its keys on the backend).
# NEXT_PUBLIC_ENABLE_GOOGLE_SIGNIN=true
# NEXT_PUBLIC_ENABLE_MICROSOFT_SIGNIN=false
# Same value as the backend's GOOGLE_CLIENT_ID (public, not the secret). Lets
# Google sign-in open immediately instead of waiting for the backend.
# GOOGLE_CLIENT_ID=

# Xelora is a desktop app: in a browser, /dashboard asks to open Xelora Desktop.
# Set to true to use the workspace in a browser (local development).
# NEXT_PUBLIC_ENABLE_WEB_APP=false

# Shown on the legal pages, footer and contact page. Set these before launch.
NEXT_PUBLIC_LEGAL_NAME=Xelora
NEXT_PUBLIC_CONTACT_EMAIL=donjesuskayiranga@gmail.com
# NEXT_PUBLIC_PRIVACY_EMAIL=
# NEXT_PUBLIC_LEGAL_ADDRESS=      # registered business address
# NEXT_PUBLIC_GOVERNING_LAW=      # e.g. "the Republic of Rwanda"
