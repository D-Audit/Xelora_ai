import { useEffect, useState } from 'react';
import {
  Pause,
  Play,
  Check,
  Eye,
  EyeOff,
  Maximize2,
  Minimize2,
  Pin,
  PinOff,
  Volume2,
  MoreVertical,
  Send,
} from 'lucide-react';
import type { FloatingAgentAction, FloatingAgentState } from '../../shared/types';

const DEFAULT_STATE: FloatingAgentState = {
  appName: 'Xelora',
  taskTitle: 'No active task',
  activeStepLabel: 'Waiting for a task…',
  status: 'idle',
  progress: 0,
  expanded: true,
  hiddenForCapture: false,
};

export function FloatingAgent() {
  const [state, setState] = useState<FloatingAgentState>(DEFAULT_STATE);
  const [pinned, setPinned] = useState(true);
  const [muted, setMuted] = useState(false);
  const [message, setMessage] = useState('');
  const [contextTag, setContextTag] = useState<'web' | 'code' | null>(null);

  useEffect(() => window.xelora.onFloatingState((next) => setState(next)), []);

  const dispatch = (action: FloatingAgentAction) => {
    void window.xelora.sendFloatingAction(action);
  };

  const togglePause = () => dispatch({ type: state.status === 'paused' ? 'resume' : 'pause' });
  const approve = () => dispatch({ type: 'approve' });

  const toggleHideForShot = () => {
    const next = !state.hiddenForCapture;
    setState((s) => ({ ...s, hiddenForCapture: next }));
    void window.xelora.setFloatingHiddenForCapture(next);
    dispatch({ type: 'toggle-hide-for-shot' });
  };

  const toggleExpanded = () => {
    setState((s) => ({ ...s, expanded: !s.expanded }));
    dispatch({ type: 'toggle-expanded' });
  };

  const attachFile = async () => {
    const result = await window.xelora.openWorkbook();
    if (result) {
      setMessage((m) => (m ? `${m} ${result.workbook.fileName}` : result.workbook.fileName));
    }
  };

  const sendMessage = () => {
    if (!message.trim()) return;
    dispatch({ type: 'send-message', message, context: contextTag });
    setMessage('');
  };

  return (
    <div className="floating-agent">
      <div className="floating-agent__header floating-agent__drag">
        <span className="floating-agent__title">{state.appName} Excel · Floating Agent</span>
        <div className="floating-agent__header-actions floating-agent__no-drag">
          <button className="floating-agent__btn" onClick={togglePause}>
            {state.status === 'paused' ? <Play size={13} /> : <Pause size={13} />}
            {state.status === 'paused' ? 'Resume' : 'Pause'}
          </button>
          <button className="floating-agent__btn floating-agent__btn--accent" onClick={approve}>
            <Check size={13} /> Approve
          </button>
          <button className="floating-agent__btn" onClick={toggleHideForShot}>
            {state.hiddenForCapture ? <Eye size={13} /> : <EyeOff size={13} />}
            {state.hiddenForCapture ? 'Shown for Shot' : 'Hide for Shot'}
          </button>
          <button className="floating-agent__btn floating-agent__btn--ghost" onClick={toggleExpanded}>
            {state.expanded ? <Minimize2 size={13} /> : <Maximize2 size={13} />}
            {state.expanded ? 'Collapse' : 'Expanded'}
          </button>
        </div>
      </div>

      {state.expanded && (
        <div className="floating-agent__task">
          <div className="floating-agent__task-label">Active Task</div>
          <div className="floating-agent__task-title">{state.activeStepLabel || state.taskTitle}</div>
          <div className="floating-agent__progress-row">
            <div className="floating-agent__progress-track">
              <div
                className="floating-agent__progress-fill"
                style={{ width: `${Math.min(100, Math.max(0, state.progress))}%` }}
              />
            </div>
            <div className="floating-agent__progress-tools">
              <button className="floating-agent__icon-btn" onClick={() => setPinned((p) => !p)} title={pinned ? 'Unpin' : 'Pin on top'}>
                {pinned ? <Pin size={13} /> : <PinOff size={13} />}
              </button>
              <button className="floating-agent__icon-btn" onClick={() => setMuted((m) => !m)} title={muted ? 'Unmute' : 'Mute'}>
                <Volume2 size={13} style={{ opacity: muted ? 0.4 : 1 }} />
              </button>
              <button className="floating-agent__icon-btn" title="More">
                <MoreVertical size={13} />
              </button>
            </div>
          </div>
        </div>
      )}

      <div className="floating-agent__composer">
        <button className="floating-agent__attach" onClick={attachFile} title="Attach a workbook">+</button>
        <button
          className={`floating-agent__chip ${contextTag === 'web' ? 'floating-agent__chip--active' : ''}`}
          onClick={() => setContextTag((c) => (c === 'web' ? null : 'web'))}
        >
          Web
        </button>
        <button
          className={`floating-agent__chip ${contextTag === 'code' ? 'floating-agent__chip--active' : ''}`}
          onClick={() => setContextTag((c) => (c === 'code' ? null : 'code'))}
        >
          Code
        </button>
        <input
          className="floating-agent__input"
          placeholder="Do anything…"
          value={message}
          onChange={(e) => setMessage(e.target.value)}
          onKeyDown={(e) => e.key === 'Enter' && sendMessage()}
        />
        <button className="floating-agent__send" onClick={sendMessage}>
          <Send size={13} /> Send
        </button>
      </div>
    </div>
  );
}
</file>

