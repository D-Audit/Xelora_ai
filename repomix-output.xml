          Object.entries(sheet.cells)
            .slice(0, 6)
            .map(([ref, cell]) => (
              <div key={ref} className="flex items-center justify-between rounded-lg bg-white px-3 py-2">
                <span>{ref}</span>
                <span className="max-w-[180px] truncate">{cellMatchesFormula(cell)}</span>
