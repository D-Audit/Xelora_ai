  workbook,
  sessionName,
  dirty,
  onOpen,
  onOpenCsv,
  onNew,
  onSample,
  onSave,
  onSaveAs,
  onUndo,
  onRedo,
  onSettings,
  onReports,
  onCleaning,
  onHome,
  onFloatingMode,
  isFloatingOpen,
}: {
