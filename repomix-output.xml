<file path="frontend/xelora/apps/desktop/src/renderer/src/useFloatingAgent.ts">
import { useCallback, useEffect, useRef, useState } from 'react';
import type { FloatingAgentAction, FloatingAgentState, WorkflowStep } from '../../shared/types';

interface UseFloatingAgentOptions {
  appName: string;
  taskTitle: string;
  workflowSteps: WorkflowStep[];
  progress: number;
  isPaused: boolean;
  onApproveAll: () => void;
  onTogglePause: () => void;
  onSendMessage: (message: string, context: 'web' | 'code' | null) => void;
}

export function useFloatingAgent(options: UseFloatingAgentOptions) {
  const { appName, taskTitle, workflowSteps, progress, isPaused, onApproveAll, onTogglePause, onSendMessage } = options;
  const [isOpen, setIsOpen] = useState(false);
  const expandedRef = useRef(true);

  const activeStep =
    workflowSteps.find((s) => s.status === 'Running') ??
    workflowSteps.find((s) => s.status === 'Needs approval') ??
    workflowSteps[0];

  useEffect(() => {
    if (!isOpen) return;
    const state: FloatingAgentState = {
      appName,
      taskTitle,
      activeStepLabel: activeStep ? activeStep.label : 'No active step',
      status: isPaused
        ? 'paused'
        : activeStep?.status === 'Needs approval'
          ? 'awaiting_approval'
          : activeStep
            ? 'running'
            : 'idle',
      progress,
      expanded: expandedRef.current,
      hiddenForCapture: false,
    };
    void window.xelora.syncFloatingState(state);
  }, [isOpen, appName, taskTitle, activeStep, progress, isPaused]);

  useEffect(() => {
    const unsubscribe = window.xelora.onFloatingAction((action: FloatingAgentAction) => {
      if (action.type === 'approve') onApproveAll();
      if (action.type === 'pause' || action.type === 'resume') onTogglePause();
      if (action.type === 'toggle-expanded') expandedRef.current = !expandedRef.current;
      if (action.type === 'send-message' && action.message) onSendMessage(action.message, action.context ?? null);
    });
    return unsubscribe;
  }, [onApproveAll, onTogglePause, onSendMessage]);

  const openFloating = useCallback(async () => {
    await window.xelora.openFloatingAgent();
    setIsOpen(true);
  }, []);

  const closeFloating = useCallback(async () => {
    await window.xelora.closeFloatingAgent();
    setIsOpen(false);
  }, []);

  return { isOpen, openFloating, closeFloating };
}
