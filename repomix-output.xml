function FooterBar({
  workbook,
  selectedCell,
  statusMessage,
  version,
  dirty,
  offline,
}: {
  workbook: SpreadsheetWorkbook | null;
  selectedCell: string;
  statusMessage: string;
  version: string;
  dirty: boolean;
  offline: boolean;
}) {
