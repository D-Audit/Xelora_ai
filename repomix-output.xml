import { Card } from '@/components/ui/card';

interface StatePanelProps {
  kind: 'loading' | 'empty' | 'error' | 'permission' | 'plan';
  title: string;
  description: string;
  actionLabel?: string;
  onAction?: () => void;
}

const iconMap = {
  loading: Loader2,
  empty: Search,
  error: AlertCircle,
  permission: Lock,
  plan: ShieldAlert,
} as const;

export function StatePanel({
  kind,
  title,
  description,
  actionLabel,
  onAction,
}: StatePanelProps) {
  const Icon = iconMap[kind];

