  'A4': '2026-07-02', 'B4': 'East', 'C4': 'Widget A', 'D4': '203', 'E4': '24.99', 'F4': '=D4*E4', 'G4': 'Birmingham',
  'A5': '2026-07-02', 'B5': 'North', 'C5': 'Widget C', 'D5': '67', 'E5': '19.00', 'F5': '=D5*E5', 'G5': 'Manchester',
