    fc.IconSet = icon_set_collection
    wb.save()

    return {"sheet": sheet_name, "range": cell_range, "style": style,
            "status": "icon_set_applied", "verified": True,
            "verification_note": "Rule added. Visual icons require manual/visual check."}
