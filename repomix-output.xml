  'A7': '2026-07-03', 'B7': 'South', 'C7': 'Widget A', 'D7': '77', 'E7': '24.99', 'F7': '=D7*E7', 'G7': 'London',
};

const SHEETS = ['Sales', 'Returns', 'Targets'];

export function SpreadsheetWorkspace({ fileName, onClose }: Props) {
