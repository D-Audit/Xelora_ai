                      <th key={heading} className="px-4 py-3 text-center font-medium text-xelora-text">
                        {heading}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody className="divide-y divide-xelora-border bg-white">
                  {comparisonRows.map((row) => (
                    <tr key={row.label}>
