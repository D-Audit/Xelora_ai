    best = None
    best_d = 1e18
    for yy in range(0, h, 3):
        for xx in range(0, w, 3):
            p = px[xx, yy]
            d = (p[0] - rgb[0]) ** 2 + (p[1] - rgb[1]) ** 2 + (p[2] - rgb[2]) ** 2
            if d < best_d:
                best_d = d
                best = (xx, yy)

    tol = 50 ** 2
    if best is not None and best_d <= tol:
