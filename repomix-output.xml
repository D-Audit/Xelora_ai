          <div className="space-y-1">
            {tasks.slice(0, 5).map(task => {
              const Icon = statusIcon[task.status] ?? Sparkles;
              const colour = statusColour[task.status] ?? 'text-xelora-text-muted';
              return (
                <button
                  key={task.id}
