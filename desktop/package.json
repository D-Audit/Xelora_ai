{
  "name": "xelora-desktop",
  "version": "1.4.8",
  "description": "Xelora - AI assistant for Excel",
  "main": "main.js",
  "author": {
    "name": "Xelora"
  },
  "license": "MIT",
  "private": true,
  "xelora": {
    "webUrl": "https://xelora-ai-lovat.vercel.app/dashboard"
  },
  "scripts": {
    "start": "electron .",
    "dist": "npm run bundle-agent && electron-builder --win",
    "bundle-agent": "powershell -ExecutionPolicy Bypass -File scripts/bundle-agent.ps1"
  },
  "build": {
    "appId": "app.xelora.desktop",
    "productName": "Xelora",
    "copyright": "Copyright 2026 Xelora",
    "publish": {
      "provider": "github",
      "owner": "D-Audit",
      "repo": "Xelora_ai"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Xelora-Setup-${version}.${ext}",
      "legalTrademarks": "Xelora",
      "sign": "./scripts/sign.js",
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xelora",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Xelora"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**",
      "agent.js"
    ],
    "extraResources": [
      {
        "from": "build/agent",
        "to": "agent",
        "filter": [
          "**/*"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Xelora",
        "schemes": [
          "xelora"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
