{
  "name": "xelora-desktop",
  "version": "1.3.0",
  "description": "Xelora Desktop - AI-powered spreadsheet automation",
  "main": "main.js",
  "author": "Xelora",
  "license": "MIT",
  "private": true,
  "xelora": {
    "webUrl": "https://YOUR-APP.vercel.app/dashboard"
  },
  "scripts": {
    "start": "electron .",
    "dist": "npm run bundle-agent && electron-builder --win",
    "bundle-agent": "powershell -ExecutionPolicy Bypass -File scripts/bundle-agent.ps1"
  },
  "build": {
    "appId": "app.xelora.desktop",
    "productName": "Xelora",
    "copyright": "Copyright 2026 Xelora",
    "publish": {
      "provider": "github",
      "owner": "D-Audit",
      "repo": "Xelora_ai"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xelora"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**",
      "agent.js"
    ],
    "extraResources": [
      {
        "from": "build/agent",
        "to": "agent",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
