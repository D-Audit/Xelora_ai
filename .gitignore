# Ignore Python cache and compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Ignore environment files
.env
.env.*

# Ignore Node dependencies and lock files
node_modules/
**/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Ignore editor and OS files
.vscode/
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore build artifacts
dist/
.next/
